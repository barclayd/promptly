{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "promptly",
  "compatibility_date": "2025-10-08",
  "compatibility_flags": ["nodejs_compat_v2", "global_fetch_strictly_public"],
  "main": "./workers/app.ts",
  "triggers": { "crons": ["* * * * *"] },
  "observability": {
    "enabled": true
  },
  "vars": {
    "MCP_ENABLED": "true",
    "MCP_AUTHORING_ENABLED": "true",
    "MCP_PILOT_WORKSPACES": "ddqz6WonIEucP0uj07z8OBuiWTQHwadU,20SkvABoFYKMBfSvJclvBE6WVYNnntSM",
    "MCP_ALLOW_DCR": "false"
  },
  "d1_databases": [
    {
      "binding": "promptly",
      "database_name": "promptly",
      "database_id": "eadc5f7c-e195-4bd0-bcb1-8e4d2950606b",
      "migrations_dir": "./migrations/drizzle"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "089b4a1d119b49ae9ec5286fae8fa10b"
    },
    {
      "binding": "PROMPTS_CACHE",
      "id": "fe422f717c1b4a8295656d6e494161a3"
    },
    {
      "binding": "AUTH_CACHE",
      "id": "8b36ae26bc6b489cb949063b68231edb"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "PRESENCE_ROOM",
        "class_name": "PresenceRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["PresenceRoom"]
    }
  ]
}
